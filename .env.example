# Database
DATABASE_URL=postgresql://oezios:oezios9@localhost:5432/distributor_system

# Application
SESSION_SECRET=your-session-secret-here
BASE_URL=http://localhost:5000

# Payment Gateway Settings
PAYMENT_PROVIDER=mercadopago  # Options: mercadopago, stripe
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret-here
MERCADOPAGO_SANDBOX=true

# Email Settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@distribuidor.com
MAIL_SUPPRESS_SEND=false